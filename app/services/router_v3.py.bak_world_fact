from __future__ import annotations

import re
from dataclasses import asdict, dataclass
from typing import Any, Dict, List


@dataclass
class RouteDecision:
    task_type: str
    answer_shape: str
    target_system: str
    confidence: float
    reasons: List[str]


SYSTEM_ANALYSIS_PATTERNS = [
    r"\banalyze\b",
    r"\bsystem\b",
    r"\bprocess\b",
    r"\bworkflow\b",
    r"\bapproval\b",
    r"\ballocation\b",
    r"\bintake\b",
    r"\breview\b",
    r"\btriage\b",
    r"\branking\b",
    r"\benforcement\b",
    r"\bdispatch\b",
    r"\bscheduler\b",
    r"\bunderwriting\b",
    r"\bmoderation\b",
    r"\bwaitlist\b",
]

ATTRIBUTION_PATTERNS = [
    r"^who invented\b",
    r"^who created\b",
    r"^who wrote\b",
    r"^who founded\b",
    r"^who developed\b",
    r"\binvented\b",
    r"\bcreator\b",
    r"\boriginated\b",
]

FORECAST_PATTERNS = [
    r"^will\b",
    r"^would\b",
    r"^is .* going to\b",
    r"\blikely\b",
    r"\bforecast\b",
    r"\bprediction\b",
    r"\bchance\b",
    r"\bprobability\b",
]

DIRECT_FACT_PATTERNS = [
    r"^what is\b",
    r"^what are\b",
    r"^when was\b",
    r"^where is\b",
    r"^define\b",
    r"^explain\b",
]

AMBIGUOUS_SHORT_PATTERNS = [
    r"^analyze this$",
    r"^explain this$",
    r"^what about this$",
    r"^what about it$",
    r"^analyze it$",
    r"^explain it$",
]


def _matches_any(text: str, patterns: List[str]) -> bool:
    return any(re.search(pattern, text, flags=re.I) for pattern in patterns)


def _extract_target_system(prompt: str) -> str:
    text = prompt.strip()

    patterns = [
        r"analyze\s+the\s+(.+?)\s+with\s+energetic paradigm",
        r"analyze\s+the\s+(.+)$",
        r"^who invented\s+(.+?)[\?]?$",
        r"^what is\s+(.+?)[\?]?$",
        r"^will\s+(.+?)[\?]?$",
    ]

    for pattern in patterns:
        match = re.search(pattern, text, flags=re.I)
        if match:
            return match.group(1).strip()

    return text


def route_prompt_v3(prompt: str) -> Dict[str, Any]:
    text = prompt.strip()
    lower = text.lower()
    reasons: List[str] = []

    if not text or len(text) < 8 or _matches_any(lower, AMBIGUOUS_SHORT_PATTERNS):
        reasons.append("prompt_too_short_or_ambiguous")
        decision = RouteDecision(
            task_type="CLARIFICATION_REQUIRED",
            answer_shape="clarify_first",
            target_system=text or "unspecified target",
            confidence=0.95,
            reasons=reasons,
        )
        return asdict(decision)

    if _matches_any(lower, ATTRIBUTION_PATTERNS):
        reasons.append("attribution_pattern_match")
        decision = RouteDecision(
            task_type="ATTRIBUTION",
            answer_shape="direct_answer",
            target_system=_extract_target_system(text),
            confidence=0.95,
            reasons=reasons,
        )
        return asdict(decision)

    if _matches_any(lower, FORECAST_PATTERNS):
        reasons.append("forecast_pattern_match")
        decision = RouteDecision(
            task_type="FORECAST",
            answer_shape="bounded_forecast",
            target_system=_extract_target_system(text),
            confidence=0.90,
            reasons=reasons,
        )
        return asdict(decision)

    if _matches_any(lower, DIRECT_FACT_PATTERNS) and "system" not in lower:
        reasons.append("direct_fact_pattern_match")
        decision = RouteDecision(
            task_type="DIRECT_FACT",
            answer_shape="direct_answer",
            target_system=_extract_target_system(text),
            confidence=0.80,
            reasons=reasons,
        )
        return asdict(decision)

    if _matches_any(lower, SYSTEM_ANALYSIS_PATTERNS):
        reasons.append("system_analysis_pattern_match")
        decision = RouteDecision(
            task_type="SYSTEM_ANALYSIS",
            answer_shape="full_ep",
            target_system=_extract_target_system(text),
            confidence=0.90,
            reasons=reasons,
        )
        return asdict(decision)

    reasons.append("fallback_to_clarification")
    decision = RouteDecision(
        task_type="CLARIFICATION_REQUIRED",
        answer_shape="clarify_first",
        target_system=_extract_target_system(text),
        confidence=0.60,
        reasons=reasons,
    )
    return asdict(decision)

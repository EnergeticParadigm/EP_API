def _render_analysis_from_structure(s):
    system = s.get("system", "the target system")
    source = s.get("source", "inputs")
    sink = s.get("sink", "outputs")
    gradient = s.get("gradient", "selection pressure")
    path = s.get("path", "processing route")
    barrier = s.get("barrier", "gates")
    loss = s.get("loss", "drop-off")
    maintenance = s.get("maintenance", "upkeep")
    control = s.get("control", "enforcement")
    fragility = s.get("fragility", "breakdown pressure")

    return {
        "core_reading": (
            f"The {system} converts {source} into {sink}, but it does so by forcing movement through "
            f"{gradient} rather than by neutral processing. What looks administrative is actually selective: "
            f"flow is narrowed, delayed, or expelled until only a controlled output reaches {sink}."
        ),
        "how_the_system_works": (
            f"Pressure enters through {source} and is routed along {path}. The choke point sits at {barrier}, "
            f"where the system decides who passes cleanly and who absorbs delay, rejection, or uncertainty. "
            f"Loss is not accidental here: {loss} is the price paid to keep throughput legible and controllable."
        ),
        "maintenance_control_fragility": (
            f"The system stays upright through {maintenance}, while {control} supplies the authority to escalate, "
            f"screen out, or override. Its fracture line appears when {fragility}: then the hidden bargain fails, "
            f"and the burden the system normally spreads quietly becomes visible as backlog, exclusion, or breakdown."
        ),
    }

def _extract_json_object(raw: str) -> dict[str, Any]:
    text = raw.strip()
    if text.startswith("```"):
        text = re.sub(r"^```(?:json)?\s*|\s*```$", "", text, flags=re.S).strip()
    start = text.find("{")
    end = text.rfind("}")
    if start == -1 or end == -1 or end <= start:
        raise ValueError(f"Model did not return a JSON object: {raw[:500]}")
    return json.loads(text[start:end + 1])


def _normalize_payload(payload: dict[str, Any], runtime: Any) -> dict[str, Any]:
    setup = payload.get("compact_ep_setup") or {}
    if not isinstance(setup, dict):
        setup = {}

    for key in REQUIRED_SETUP_FIELDS:
        if key not in setup or setup[key] in (None, "", []):
            if key == "system":
                setup[key] = getattr(runtime, "task_system", "unspecified")
            elif key == "active_forms":
                setup[key] = getattr(runtime, "active_forms", [])
            else:
                setup[key] = "UNSPECIFIED"

    if not isinstance(setup.get("active_forms"), list):
        setup["active_forms"] = [str(setup["active_forms"])]

    analysis = payload.get("analysis", "")

    analysis_sections: dict[str, str] | None = None
    if isinstance(analysis, dict):
        core = str(analysis.get("core_reading", "")).strip()
        works = str(analysis.get("how_the_system_works", "")).strip()
        mcf = str(analysis.get("maintenance_control_fragility", "")).strip()

        analysis_sections = {
            "core_reading": core,
            "how_the_system_works": works,
            "maintenance_control_fragility": mcf,
        }

        analysis_text = "\n\n".join(
            [
                f"Core reading:\n{core}",
                f"How the system works:\n{works}",
                f"Maintenance, control, and fragility:\n{mcf}",
            ]
        ).strip()
    else:
        analysis_text = str(analysis).strip()

    canonical = {
        "system": setup["system"],
        "flow_objects": {
            "source": setup["source"],
            "sink": setup["sink"],
            "gradient": setup["gradient"],
            "path": setup["path"],
        },
        "constraint_objects": {
            "barrier": setup["barrier"],
            "loss": setup["loss"],
            "maintenance": setup["maintenance"],
            "control": setup["control"],
            "fragility": setup["fragility"],
        },
        "structural_commitments": {
            "asymmetry": "UNSPECIFIED",
            "pressure_point": "UNSPECIFIED",
            "tradeoff": "UNSPECIFIED",
            "actors": [],
            "cost_bearer": "UNSPECIFIED",
            "fracture_condition": "UNSPECIFIED",
        },
    }

    return {
        "compact_ep_setup": setup,
        "canonical_setup": canonical,
        "analysis": analysis_text,
        "analysis_sections": analysis_sections,
    }



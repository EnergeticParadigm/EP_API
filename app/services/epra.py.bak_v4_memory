        thesis_terms = [
            "thesis",
            "not only answer",
            "deep",
            "full analysis",
            "structural",
            "energetic paradigm",
            "ep answer",
            "trueep",
            "true ep",
        ]

        conflict_terms = [
            "war",
            "conflict",
            "ceasefire",
            "occupation",
            "regime",
            "iran",
            "israel",
            "china",
            "russia",
            "taiwan",
            "ukraine",
            "gaza",
            "strait",
            "hormuz",
            "blockade",
        ]

        return any(x in t for x in thesis_terms) or any(x in t or x in target for x in conflict_terms)


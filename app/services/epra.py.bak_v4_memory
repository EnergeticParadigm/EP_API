    def reconstruct(self, fragments: list[str]) -> Dict[str, Any]:
        joined = "\n".join(fragments)
        validity = self.validator.validate_text(joined)
        return {
            "reconstruction_candidate": joined,
            "validity": validity,
            "note": "Replace with typed fragment normalization and support/consistency graph later.",

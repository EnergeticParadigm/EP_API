def _render_validation_text(payload: dict[str, Any]) -> str:
    s = payload["compact_ep_setup"]
    lines = [
        f"System: {s['system']}",
        f"Active forms: {', '.join(s['active_forms']) if s['active_forms'] else 'UNSPECIFIED'}",
        f"Source: {s['source']}",
        f"Sink: {s['sink']}",
        f"Gradient: {s['gradient']}",
        f"Path: {s['path']}",
        f"Barrier: {s['barrier']}",
        f"Loss: {s['loss']}",
        f"Maintenance: {s['maintenance']}",
        f"Control: {s['control']}",
        f"Fragility: {s['fragility']}",
        "",
        "Analysis:",
        payload["analysis"],
    ]
    return "\n".join(lines)


def _repair_note(validity: dict[str, Any]) -> str | None:
    if validity["label"] == "Valid EP":
        return None

    missing = []
    gates = validity.get("gates", {})

    if not gates.get("setup"):
        missing.append("explicit EP setup")
    if not gates.get("maintenance"):
        missing.append("maintenance")
    if not gates.get("control"):
        missing.append("control")
    if not gates.get("fragility"):
        missing.append("fragility")
    if not gates.get("asymmetry"):
        missing.append("asymmetry")
    if not gates.get("pressure"):
        missing.append("pressure accumulation or bottleneck")
    if not gates.get("tradeoff"):
        missing.append("tradeoff")
    if not gates.get("specificity"):
        missing.append("target-specific detail")

    if not missing:
        missing.append("validity-ready structure")

    return "Add explicit " + ", ".join(missing) + "."



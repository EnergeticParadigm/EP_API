    def __init__(self) -> None:
        self.runtime_builder = RuntimeBuilder()
        self.validator = ValidityEngine()
        self.gateway = OpenAIResponsesGateway()
        self.system_prompt = HARD_EP_CONSTRAINTS + "\n\n" + ANALYZE_SYSTEM_PROMPT
        self.structure_prompt = HARD_EP_CONSTRAINTS + "\n\n" + STRUCTURE_ONLY_PROMPT


    def _extract_structure(self, runtime, task: str):
        raw = self.gateway.generate(
            system_prompt=self.structure_prompt,
            runtime_state=runtime.__dict__,
            task=task,
        )
        payload = _extract_json_object(raw)
        payload = _normalize_payload(payload, runtime=runtime)
        payload = _fill_structural_commitments(payload)
        payload["analysis"] = _render_analysis_from_structure(payload["compact_ep_setup"])
        payload = _fill_structural_commitments(payload)
        return payload



